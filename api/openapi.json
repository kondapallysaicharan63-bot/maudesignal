{
  "components": {
    "schemas": {
      "AskRequest": {
        "additionalProperties": false,
        "description": "Body of ``ask``.",
        "properties": {
          "question": {
            "description": "A question about stored MAUDE reports, recalls, 510(k)s or the MDR clock.",
            "examples": [
              "What changed this week for LLZ?"
            ],
            "maxLength": 500,
            "minLength": 3,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "AuditEntry": {
        "additionalProperties": false,
        "description": "One entry of the hash-chained audit log (the ``audit_export`` shape).",
        "properties": {
          "action": {
            "title": "Action",
            "type": "string"
          },
          "actor": {
            "description": "connector:key:<server-side keyed hash of the key> or public.",
            "title": "Actor",
            "type": "string"
          },
          "entity_id": {
            "title": "Entity Id",
            "type": "string"
          },
          "entry_hash": {
            "title": "Entry Hash",
            "type": "string"
          },
          "payload_json": {
            "description": "Tool, inputs, answer SHA-256, gate counts and provenance as JSON text.",
            "title": "Payload Json",
            "type": "string"
          },
          "prev_hash": {
            "title": "Prev Hash",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "ts": {
            "description": "UTC time, ISO 8601, no zone suffix.",
            "title": "Ts",
            "type": "string"
          }
        },
        "required": [
          "seq",
          "ts",
          "actor",
          "action",
          "entity_id",
          "payload_json",
          "prev_hash",
          "entry_hash"
        ],
        "title": "AuditEntry",
        "type": "object"
      },
      "AuditRecent": {
        "description": "``GET /v1/audit/recent`` body.",
        "properties": {
          "chain": {
            "$ref": "#/components/schemas/ChainStatus"
          },
          "entries": {
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            },
            "title": "Entries",
            "type": "array"
          },
          "store": {
            "description": "upstash_redis or in_memory_per_instance.",
            "title": "Store",
            "type": "string"
          }
        },
        "required": [
          "store",
          "chain",
          "entries"
        ],
        "title": "AuditRecent",
        "type": "object"
      },
      "ChainStatus": {
        "description": "Result of re-computing the hashes of the entries returned.",
        "properties": {
          "entries_checked": {
            "title": "Entries Checked",
            "type": "integer"
          },
          "first_bad_seq": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Bad Seq"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "verified",
          "entries_checked"
        ],
        "title": "ChainStatus",
        "type": "object"
      },
      "CheckWindow": {
        "additionalProperties": false,
        "description": "The two windows of a check (dates as YYYYMMDD).",
        "properties": {
          "as_of": {
            "title": "As Of",
            "type": "string"
          },
          "baseline_end": {
            "title": "Baseline End",
            "type": "string"
          },
          "baseline_start": {
            "title": "Baseline Start",
            "type": "string"
          },
          "current_end": {
            "title": "Current End",
            "type": "string"
          },
          "current_start": {
            "title": "Current Start",
            "type": "string"
          }
        },
        "required": [
          "as_of",
          "current_start",
          "current_end",
          "baseline_start",
          "baseline_end"
        ],
        "title": "CheckWindow",
        "type": "object"
      },
      "ErrorBody": {
        "description": "Error detail (never contains a key).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Error envelope for 4xx and 5xx responses.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "Fact": {
        "additionalProperties": false,
        "description": "One checkable statement with the link a reader can open to see it.",
        "properties": {
          "link": {
            "description": "https link to the openFDA query or record behind the fact.",
            "title": "Link",
            "type": "string"
          },
          "link_label": {
            "default": "openFDA",
            "description": "What the link opens.",
            "title": "Link Label",
            "type": "string"
          },
          "text": {
            "description": "One plain-language fact; every number comes from the source.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "link"
        ],
        "title": "Fact",
        "type": "object"
      },
      "Health": {
        "description": "``GET /v1/health`` body.",
        "properties": {
          "feedback_store": {
            "title": "Feedback Store",
            "type": "string"
          },
          "limits_scope": {
            "title": "Limits Scope",
            "type": "string"
          },
          "read_only": {
            "title": "Read Only",
            "type": "boolean"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "state_store": {
            "title": "State Store",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "title": "Tools",
            "type": "array"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "read_only",
          "tools",
          "limits_scope",
          "state_store",
          "feedback_store"
        ],
        "title": "Health",
        "type": "object"
      },
      "LiveCheckData": {
        "additionalProperties": false,
        "description": "``LiveCheck.to_dict()`` of ``monitor/live_check.py``, field for field.\n\nShares are fractions from 0 to 1; ``severe_share_delta_pp`` is in percentage points;\n``queries`` is a list of ``[label, openFDA url]`` pairs, one per figure.",
        "properties": {
          "as_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "As Of"
          },
          "baseline_count": {
            "title": "Baseline Count",
            "type": "integer"
          },
          "baseline_severe_count": {
            "title": "Baseline Severe Count",
            "type": "integer"
          },
          "baseline_severe_share": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Severe Share"
          },
          "baseline_weekly_mean": {
            "title": "Baseline Weekly Mean",
            "type": "number"
          },
          "change": {
            "title": "Change",
            "type": "string"
          },
          "classification": {
            "enum": [
              "new_signal",
              "severity_escalation",
              "spike",
              "stable"
            ],
            "title": "Classification",
            "type": "string"
          },
          "current_count": {
            "title": "Current Count",
            "type": "integer"
          },
          "current_event_type_counts": {
            "items": {
              "items": {},
              "type": "array"
            },
            "title": "Current Event Type Counts",
            "type": "array"
          },
          "current_severe_count": {
            "title": "Current Severe Count",
            "type": "integer"
          },
          "current_severe_share": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Current Severe Share"
          },
          "new_event_types": {
            "items": {
              "type": "string"
            },
            "title": "New Event Types",
            "type": "array"
          },
          "prior_report_count": {
            "title": "Prior Report Count",
            "type": "integer"
          },
          "product_code": {
            "title": "Product Code",
            "type": "string"
          },
          "queries": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "title": "Queries",
            "type": "array"
          },
          "severe_share_delta_pp": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Severe Share Delta Pp"
          },
          "spike_ratio": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Spike Ratio"
          },
          "triggers": {
            "items": {
              "type": "string"
            },
            "title": "Triggers",
            "type": "array"
          },
          "window": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CheckWindow"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "product_code",
          "as_of",
          "window",
          "classification",
          "triggers",
          "current_count",
          "current_severe_count",
          "current_severe_share",
          "baseline_count",
          "baseline_weekly_mean",
          "baseline_severe_count",
          "baseline_severe_share",
          "severe_share_delta_pp",
          "spike_ratio",
          "prior_report_count",
          "new_event_types",
          "current_event_type_counts",
          "queries",
          "change"
        ],
        "title": "LiveCheckData",
        "type": "object"
      },
      "Provenance": {
        "additionalProperties": false,
        "description": "Where the data came from and how fresh it is.",
        "properties": {
          "data_dates": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Dates the data covers (a stored snapshot, or the live window).",
            "title": "Data Dates"
          },
          "kind": {
            "description": "stored_demo_snapshot, live_openfda, recorded_answer or live_model.",
            "enum": [
              "stored_demo_snapshot",
              "live_openfda",
              "recorded_answer",
              "live_model"
            ],
            "title": "Kind",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Why this source was used, if not obvious.",
            "title": "Note"
          },
          "queried_at_utc": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "UTC time of the live openFDA query or live model call.",
            "title": "Queried At Utc"
          },
          "source": {
            "description": "Plain description of the source.",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "source"
        ],
        "title": "Provenance",
        "type": "object"
      },
      "PublicCheckAnswer": {
        "additionalProperties": false,
        "description": "The keyless web answer: the normal answer plus the full figures behind it.",
        "properties": {
          "advisory": {
            "default": "Advisory triage aid for quality and regulatory review; not medical advice; nothing is filed with FDA.",
            "title": "Advisory",
            "type": "string"
          },
          "check": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LiveCheckData"
              },
              {
                "type": "null"
              }
            ],
            "description": "The live check behind the answer (null when openFDA could not be reached and the stored snapshot answered instead)."
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "title": "Facts",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "speakable": {
            "description": "1 to 3 plain sentences, no markdown, written to be read aloud.",
            "title": "Speakable",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "withheld": {
            "description": "Only ask() uses this; gate-withheld sentences.",
            "items": {
              "$ref": "#/components/schemas/WithheldSentence"
            },
            "title": "Withheld",
            "type": "array"
          }
        },
        "required": [
          "tool",
          "speakable",
          "provenance"
        ],
        "title": "PublicCheckAnswer",
        "type": "object"
      },
      "ToolAnswer": {
        "additionalProperties": false,
        "description": "What every tool returns.",
        "properties": {
          "advisory": {
            "default": "Advisory triage aid for quality and regulatory review; not medical advice; nothing is filed with FDA.",
            "title": "Advisory",
            "type": "string"
          },
          "facts": {
            "items": {
              "$ref": "#/components/schemas/Fact"
            },
            "title": "Facts",
            "type": "array"
          },
          "provenance": {
            "$ref": "#/components/schemas/Provenance"
          },
          "speakable": {
            "description": "1 to 3 plain sentences, no markdown, written to be read aloud.",
            "title": "Speakable",
            "type": "string"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          },
          "withheld": {
            "description": "Only ask() uses this; gate-withheld sentences.",
            "items": {
              "$ref": "#/components/schemas/WithheldSentence"
            },
            "title": "Withheld",
            "type": "array"
          }
        },
        "required": [
          "tool",
          "speakable",
          "provenance"
        ],
        "title": "ToolAnswer",
        "type": "object"
      },
      "WithheldSentence": {
        "additionalProperties": false,
        "description": "A sentence the gate did not verify. It is never part of ``speakable``.",
        "properties": {
          "claim_kinds": {
            "description": "Kinds of claim the sentence made (e.g. count, quote).",
            "items": {
              "type": "string"
            },
            "title": "Claim Kinds",
            "type": "array"
          },
          "reason": {
            "description": "Why the gate withheld it.",
            "title": "Reason",
            "type": "string"
          },
          "status": {
            "const": "withheld",
            "default": "withheld",
            "title": "Status",
            "type": "string"
          },
          "text": {
            "description": "NOT VERIFIED. Do not state or speak this as fact.",
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "reason"
        ],
        "title": "WithheldSentence",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Read-only API key. Send it only in this header.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "contact": {
      "name": "MaudeSignal (open source)",
      "url": "https://github.com/kondapallysaicharan63-bot/maudesignal/issues"
    },
    "description": "Read-only MaudeSignal tools for a Meta Muse connector. Each answer has a short speakable summary, facts that each carry an openFDA or record link, a fixed advisory line and provenance (stored demo snapshot with dates, or live openFDA with the query time). Advisory triage aid for quality and regulatory review; not medical advice; nothing is filed with FDA. Every key is read-only. Sentences from ask are checked by a deterministic claim gate; withheld sentences are listed separately and are never part of the speakable text. Limits: the per-key rate limit and the per-key daily cost cap are shared by every server instance when an Upstash Redis store is configured (GET /v1/health says which); otherwise they live in each instance's memory and temporary storage, are per instance and reset on a cold start. In that case live Muse Spark answers stay switched off unless the operator sets an explicit per-instance override; ask then returns the closest recorded answer, labelled recorded. Repeated wrong keys from one address get 429. /v1/public/check_device_type needs no key (per-address limit, six-hour cache) and never calls the model.",
    "termsOfService": "https://maudesignal-api.vercel.app/terms",
    "title": "MaudeSignal connector API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/audit/recent": {
      "get": {
        "description": "Read-only. The last entries (default 20, at most 200) of the append-only, hash-chained log of tool calls: tool, inputs, answer SHA-256, gate counts, provenance and the caller's key id (a keyed hash held by the server; never the key). An `ask` question is stored as its SHA-256 and length, not its text. `chain.verified` is recomputed on every call.",
        "operationId": "audit_recent",
        "parameters": [
          {
            "description": "How many entries.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "description": "How many entries.",
              "maximum": 200,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditRecent"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid X-API-Key."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Input not usable."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit reached; see Retry-After."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Audit store down."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Most recent audit entries, with the chain re-checked",
        "tags": [
          "service"
        ],
        "x-maudesignal-read-only": true,
        "x-maudesignal-scope": "read"
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service status (no key needed)",
        "tags": [
          "service"
        ]
      }
    },
    "/v1/public/check_device_type": {
      "get": {
        "description": "Read-only, no API key. The same answer as check_device_type plus `check`, the figures behind it: classification, change, counts, shares, window and the openFDA queries (label, url). openFDA is queried from the server, with the server's own openFDA key and the MaudeSignal user agent. Limits: a per-address limit (default 10 per hour) and a six-hour cache per product code. Browsers may call it only from origins listed by the operator (no wildcard). It never calls the model.",
        "operationId": "public_check_device_type",
        "parameters": [
          {
            "description": "Three-letter FDA product code, e.g. LLZ.",
            "in": "query",
            "name": "product_code",
            "required": true,
            "schema": {
              "description": "Three-letter FDA product code, e.g. LLZ.",
              "pattern": "^[A-Za-z]{3}$",
              "title": "Product Code",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicCheckAnswer"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Product code not usable."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Per-address limit reached."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "openFDA unreachable."
          }
        },
        "summary": "Check any device type live on openFDA (no key, for the web workspace)",
        "tags": [
          "public"
        ],
        "x-maudesignal-read-only": true,
        "x-maudesignal-scope": "read"
      }
    },
    "/v1/tools/ask": {
      "post": {
        "description": "Read-only (POST only because the question is in the body). Muse Spark answers through deterministic tools over stored records; every sentence passes the claim gate. Withheld sentences are listed in `withheld` and are never in `speakable`. With no model key, or after the key's daily cost cap, the closest recorded answer is returned and labelled recorded.",
        "operationId": "ask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolAnswer"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid X-API-Key."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Input not usable."
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limit reached; see Retry-After."
          },
          "502": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Nothing to answer from."
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Ask the Muse Spark copilot",
        "tags": [
          "tools"
        ],
        "x-maudesignal-read-only": true,
        "x-maudesignal-scope": "read"
      }
    },
    "/v1/tools/check_device_type": {
      "get": {
        "description": "Read-only. Live openFDA report counts for any product code, using the same four rules, windows and thresholds as the weekly detector.",
        "operationId": "check_device_type",
        "parameters": [
