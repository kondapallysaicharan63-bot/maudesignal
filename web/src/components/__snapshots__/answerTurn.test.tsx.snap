// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`classic layout > is drawn exactly as before (snapshot taken from the classic code before v2 existed) 1`] = `"<div class="space-y-6" data-testid="live-chat"><div><p class="ms-kicker">Live</p><h1 class="t-title-lg m-0">Ask Muse Spark</h1><p class="mt-1 max-w-xl text-ink-2">Type a question or press the mic. Greetings and simple lookups are answered directly at no cost; open questions go to Muse Spark. Every FDA fact passes the claim gate before you see it.</p><p class="m-0 mt-2 flex flex-wrap items-center gap-2"><button type="button" class="ms-btn ms-btn--secondary" style="height: 40px;" aria-pressed="true" data-testid="speaker-toggle"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12 3a3 3 0 0 0-3 3v6a3 3 0 0 0 6 0V6a3 3 0 0 0-3-3zM6 11a6 6 0 0 0 12 0M12 17v4"></path></svg> Speaker on</button><button type="button" class="ms-btn ms-btn--secondary" style="height: 40px;">Clear conversation</button></p><p class="m-0 mt-2 text-[15px] text-ink-2" data-testid="voice-note">Audio is sent once for transcription and not stored. Do not say patient details.</p></div><div role="log" aria-live="polite" aria-label="Conversation" class="space-y-8"><article class="space-y-3" data-testid="live-turn" data-status="done"><div class="ml-auto max-w-[85%] rounded-md bg-sunk px-4 py-3" data-testid="user-bubble"><p class="ws-wrap m-0 whitespace-pre-wrap">What changed this week for LLZ?</p></div><div data-testid="live-answer" data-mode="live" data-tier="live"><p class="m-0 flex flex-wrap items-center gap-2"><span class="ws-pill bg-success-soft text-success" data-testid="mode-badge">Live answer</span><span class="text-[15px] text-ink-2" data-testid="limits">9 live questions left today</span></p><div class="mt-2"><ol class="m-0 list-none space-y-1 p-0 text-[15px]" aria-label="Steps of this run" data-testid="live-trace"><li class="flex flex-wrap items-center gap-x-2 gap-y-1" data-testid="trace-step"><span class="ms-num w-5 shrink-0 text-ink-2">1</span><span class="font-semibold">Muse Spark answers from stored records</span><span class="ms-code">Muse Spark</span><span class="ms-num text-ink-2">812 ms</span><span class="ws-pill bg-success-soft text-success">done</span></li><li class="flex flex-wrap items-center gap-x-2 gap-y-1" data-testid="trace-step"><span class="ms-num w-5 shrink-0 text-ink-2">2</span><span class="font-semibold">Read-only tools and claim gate</span><span class="ms-num text-ink-2">6 ms</span><span class="ws-pill bg-success-soft text-success">done</span><span class="ws-wrap text-ink-2">1 tool call(s)</span></li></ol></div><ul class="m-0 mt-2 list-none p-0" data-testid="answer-sentences"><li class="py-1.5" data-testid="answer-sentence"><span class="ws-wrap">33 reports were stored for the week (report 50426770).</span><span class="mt-1 block text-[15px]" data-testid="sentence-links"><span><a href="https://www.accessdata.fda.gov/r?id=50426770" target="_blank" rel="noreferrer" class="text-accent underline">Report 50426770</a></span></span></li><li class="py-1.5" data-testid="answer-sentence"><span class="ws-wrap">Two device types had more serious reports than usual.</span></li></ul><p class="ws-wrap m-0 mt-2 text-[16px] text-ink-2" data-testid="held-back">1 sentence held back: a number did not match the stored data</p><p class="m-0 mt-2 flex flex-wrap items-center gap-2 text-[15px] text-ink-2"><button type="button" class="ms-btn ms-btn--secondary" style="height: 36px;" aria-label="Read this answer aloud">Read aloud</button><span class="ms-num" data-testid="answer-cost">Cost of this answer: $0.0123</span></p><p class="m-0 mt-2 text-[15px] text-ink-2" data-testid="not-advice">Not medical advice. Signals for a person to review; nothing is filed with FDA.</p></div></article></div><div></div></div>"`;
