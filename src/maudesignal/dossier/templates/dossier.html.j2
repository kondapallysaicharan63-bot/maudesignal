{#- Signal Evaluation & CAPA dossier. HACKATHON-BUILT (Oct 26 – Nov 4, 2026).
    Every number is printed through the fig() macro, which tags it with the claim
    that re-derives it (data-claim). Do not print numbers any other way. -#}
{%- macro fig(f) -%}<span class="fig" data-claim="{{ f.claim_json }}">{{ f.display }}</span>{%- endmacro -%}
{%- macro tbc(lines=3, who=true) -%}
<div class="tbc">
  <div class="tbc-label">{{ TBC }}</div>
  {%- for _ in range(lines) %}<div class="line"></div>{% endfor %}
  {%- if who %}<div class="tbc-sign"><span>Name: ______________________</span><span>Date (UTC): ____________</span></div>{% endif %}
</div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ d.doc_id }} — Signal Evaluation &amp; CAPA-need Evidence</title>
<style>
@page {
  size: Letter;
  margin: 24mm 15mm 20mm 15mm;
  @top-left { content: "MaudeSignal · Signal Evaluation & CAPA Record"; font: 7.5pt Helvetica, Arial, sans-serif; color: #444; }
  @top-center { content: "{{ css.doc_line }}"; font: bold 8pt Helvetica, Arial, sans-serif; color: #1c2b33; }
  @top-right { content: "{{ css.header_stamp }}"; font: bold 7.5pt Helvetica, Arial, sans-serif; color: {{ css.stamp_color }}; }
  @bottom-left { content: "{{ css.confidentiality }}"; font: 6.5pt Helvetica, Arial, sans-serif; color: #555; width: 70%; }
  @bottom-right { content: "Page " counter(page) " of " counter(pages); font: bold 8pt Helvetica, Arial, sans-serif; color: #1c2b33; }
  @bottom-center { content: ""; }
  {% if css.wm_default %}background: url("{{ css.wm_default }}") no-repeat center center;{% endif %}
}
@page cover {
  {% if css.wm_cover %}background: url("{{ css.wm_cover }}") no-repeat center center;{% else %}background: none;{% endif %}
  @top-right { content: "{{ css.cover_stamp }}"; font: bold 7.5pt Helvetica, Arial, sans-serif; color: {{ css.cover_stamp_color }}; }
}
@page mdr {
  background: url("{{ css.wm_mdr }}") no-repeat center center;
  @top-right { content: "{{ css.mdr_stamp }}"; font: bold 7.5pt Helvetica, Arial, sans-serif; color: #b3261e; }
}
html { font-family: Helvetica, Arial, sans-serif; font-size: 9pt; color: #1c2b33; line-height: 1.35; }
body { margin: 0; }
section { page-break-inside: auto; }
section.cover { page: cover; font-size: 8.4pt; }
section.cover h3 { margin: 2.5mm 0 1mm 0; }
section.cover .stamp { margin: 0 0 1.5mm 0; padding: 1.5mm; }
section.cover .note, section.cover .gap { margin: 1.2mm 0; padding: 1mm 2.2mm; }
table.dc th { width: 17%; } table.dc td { width: 33%; }
.sig td { height: 6.5mm; }
.toc { columns: 2; column-gap: 8mm; }
section.mdr { page: mdr; break-before: page; }
section.newpage { break-before: page; }
h1 { font-size: 17pt; margin: 0 0 2mm 0; }
h2 { font-size: 12pt; border-bottom: 1.5pt solid #1c2b33; padding-bottom: 1mm; margin: 0 0 3mm 0; }
h3 { font-size: 9.5pt; margin: 4mm 0 1.5mm 0; }
.sub { color: #555; font-size: 9pt; margin-bottom: 4mm; }
table { border-collapse: collapse; width: 100%; margin: 1mm 0 3mm 0; }
th, td { border: 0.6pt solid #9aa4ae; padding: 0.8mm 1.5mm; vertical-align: top; text-align: left; }
th { background: #eef1f4; font-weight: bold; }
table.kv th { width: 30%; }
table.ev { font-size: 7.2pt; }
table.ev td.ex { font-size: 6.8pt; color: #333; }
table.mdrt { font-size: 7.4pt; }
thead { display: table-header-group; }
tr { page-break-inside: avoid; }
.fig { font-weight: bold; }
.stamp { border: 2pt solid #b3261e; color: #b3261e; font-weight: bold; text-align: center; padding: 2mm; margin: 0 0 3mm 0; font-size: 10pt; letter-spacing: 0.5pt; }
.stamp.big { font-size: 13pt; padding: 3mm; }
.stamp.ok { border-color: #1e7b3a; color: #1e7b3a; }
.note { border-left: 3pt solid #c9d3df; background: #f5f8fc; padding: 1.5mm 2.5mm; margin: 2mm 0; font-size: 8pt; }
.gap { border-left: 3pt solid #e0a100; background: #fff8e6; padding: 1.5mm 2.5mm; margin: 2mm 0; font-size: 7.8pt; }
