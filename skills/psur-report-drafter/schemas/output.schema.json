{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PsurReportDrafterOutput",
  "description": "Structured PSUR section draft for an FDA AI/ML medical device. Only contains fields the LLM is responsible for generating; metadata (product_code, period dates, skill_name, model_used) is injected by the generator.",
  "type": "object",
  "required": [
    "executive_summary",
    "signal_assessment",
    "sections",
    "recommended_actions",
    "confidence_score"
  ],
  "properties": {
    "executive_summary": {
      "type": "string",
      "minLength": 80,
      "maxLength": 800
    },
    "signal_assessment": {
      "type": "string",
      "enum": ["no_signal", "potential_signal", "confirmed_signal"]
    },
    "sections": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["title", "content"],
        "properties": {
          "title": { "type": "string" },
          "content": { "type": "string", "minLength": 50 }
        },
        "additionalProperties": false
      }
    },
    "recommended_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "maxLength": 200 }
    },
    "confidence_score": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 0.95
    },
    "draft_notes": { "type": "string" }
  },
  "additionalProperties": false
}
